rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated admin
    function isAdmin() {
      return request.auth != null;
    }

    // Public read for products & services; Admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /productCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer can create quotation enquiries without authentication
    // Only authenticated admin can read/update/delete enquiries
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.customer.name != null 
                    && request.resource.data.customer.phone != null
                    && request.resource.data.customer.email != null
                    && request.resource.data.customer.address != null;
      allow read, update, delete: if isAdmin();
    }

    // Admin accounts
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
